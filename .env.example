# 复制成 .env 或直接用 wrangler pages secret put 注入，切勿提交真实值
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 管理端鉴权：openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-random-64-hex

# 额度与限流
DAILY_QUOTA=100
RATE_PER_MIN=15
GLOBAL_DAILY_CAP=3000
CORS_ORIGIN=*

# 充值密钥（只在本机复算时用，不要上传）
PAY_KEY_SECRET=change-me-too

# 可选：短信与语音
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
CF_ACCOUNT_ID=
CF_AI_TOKEN=
